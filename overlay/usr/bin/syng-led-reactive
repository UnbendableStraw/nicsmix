#!/usr/bin/env python3
# syng-led-reactive — sound-reactive RGBW LED driver for the Syng Cell.
#
# Taps the JACK playback mix (what the speaker is playing) via
#   jack_capture --write-to-stdout   (raw 16-bit LE, no WAV header / no FIFO)
# does a small FFT in numpy, and drives the 4 PWM channels directly.
#
# LED model (reverse-engineered from ledmanager):
#   pwmchip0 = White, pwmchip1 = Green, pwmchip2 = Red, pwmchip3 = Blue
#   duty_cycle = period * value   (value 0.0..1.0, linear)
#
# ledmanager is stopped while this runs and restarted on exit.
#
# Usage:
#   syng-led-reactive [--mode vu|spectrum|beat|rainbow|pulse|party|flow|groove|bloom|shimmer]
#                     [--source playback|mic|viz] [--ports "p1,p2"]
#                     [--fps 60] [--gain 1.0] [--rate 48000] [--period 22767]
#                     [--viz-port 7249] [--debug] [--no-manage]
# Ctrl-C to quit (restores ledmanager).
#
# --source viz : listen for the Syng VisualizationDataBroadcast feed (msgpack over
#   UDP) instead of tapping JACK. On grouped speakers the primary's syng-agent fans
#   this feed out to every cell, so all grouped cells react in sync to the real
#   audio with NO microphone. The 88-bin spectrum is mapped to the same
#   bass/mid/treble/overall envelope the JACK path produces, so every mode works.
# Python 3.7 / numpy compatible.

import argparse, math, os, random, select, signal, socket, struct, subprocess, sys, threading, time
import numpy as np

CHIP = {"W": 0, "G": 1, "R": 2, "B": 3}
PWMBASE = "/sys/class/pwm/pwmchip{}"
LED_PUB = "/dev/shm/syng-led-rgbw"   # what this speaker is glowing, for the agent (and so the sound field can match)

class Pwm:
    def __init__(self, period):
        self.period = int(period)
        for c in CHIP.values():
            base = PWMBASE.format(c)
            try:
                if not os.path.isdir(base + "/pwm0"):
                    self._w(base + "/export", "0"); time.sleep(0.05)
                self._w(base + "/pwm0/period", str(self.period))
                self._w(base + "/pwm0/enable", "1")
            except OSError as e:
                sys.stderr.write("pwm chip%d init: %s\n" % (c, e))
        self._duty = {c: -1 for c in CHIP.values()}
        self._fd = {}
        self._pub_t = 0.0

    def _w(self, path, val):
        with open(path, "w") as f:
            f.write(val)

    def set_rgbw(self, r, g, b, w):
        self._publish(r, g, b, w)
        for color, v in (("R", r), ("G", g), ("B", b), ("W", w)):
            c = CHIP[color]
            v = 0.0 if v < 0 else (1.0 if v > 1 else v)
            duty = int(self.period * v + 0.5)
            if duty != self._duty[c]:
                try:
                    self._write_duty(c, duty)
                    self._duty[c] = duty
                except OSError:
                    pass

    def _write_duty(self, c, duty):
        """sysfs takes a whole value per write at offset 0, so the file can stay open: at 60 fps the open/close
        pair cost more than everything else this loop does (measured: 0.25 ms per change on the Cell)."""
        fd = self._fd.get(c)
        if fd is None:
            fd = self._fd[c] = os.open(PWMBASE.format(c) + "/pwm0/duty_cycle", os.O_WRONLY)
        try:
            os.pwrite(fd, str(duty).encode(), 0)
        except OSError:
            try: os.close(fd)
            except OSError: pass
            self._fd.pop(c, None)
            self._w(PWMBASE.format(c) + "/pwm0/duty_cycle", str(duty))

    def _publish(self, r, g, b, w):
        """Current colour -> /dev/shm, ~20 Hz. The agent puts it on the viz feed so the phone's and the
        browser's sound field can glow the same colour as the speaker does."""
        now = time.time()
        if now - self._pub_t < 0.05:
            return
        self._pub_t = now
        cl = lambda v: 0.0 if v < 0 else (1.0 if v > 1 else float(v))
        try:
            with open(LED_PUB + ".tmp", "w") as f:
                f.write("%.4f %.4f %.4f %.4f %.3f\n" % (cl(r), cl(g), cl(b), cl(w), now))
            os.replace(LED_PUB + ".tmp", LED_PUB)
        except OSError:
            pass

    def off(self):
        self.set_rgbw(0, 0, 0, 0)

def hsv_to_rgb(h, s, v):
    i = int(h * 6.0) % 6
    f = h * 6.0 - int(h * 6.0)
    p = v * (1 - s); q = v * (1 - s * f); t = v * (1 - s * (1 - f))
    return [(v,t,p),(q,v,p),(p,v,t),(p,q,v),(t,p,v),(v,p,q)][i]

class Bands:
    def __init__(self, rate, n, gain):
        self.rate = rate; self.n = n; self.gain = gain
        self.win = np.hanning(n).astype(np.float32)
        self.ring = np.zeros(n, dtype=np.float32)
        freqs = np.fft.rfftfreq(n, 1.0 / rate)
        self.bass = freqs < 250
        self.mid = (freqs >= 250) & (freqs < 2000)
        self.tre = freqs >= 2000
        self.env = np.zeros(4, dtype=np.float32)
        self.agc_band = 1e-3
        self.agc_rms = 1e-3
        self.prev_bass = 0.0

    def feed(self, new):
        k = len(new)
        if k >= self.n:
            self.ring = new[-self.n:].astype(np.float32)
        elif k > 0:
            self.ring = np.concatenate([self.ring[k:], new.astype(np.float32)])
        mag = np.abs(np.fft.rfft(self.ring * self.win))
        rms = float(np.sqrt(np.mean(new ** 2))) if k else 0.0
        raw = np.array([mag[self.bass].mean() if self.bass.any() else 0,
                        mag[self.mid].mean() if self.mid.any() else 0,
                        mag[self.tre].mean() if self.tre.any() else 0,
                        rms], dtype=np.float32)
        raw[:3] *= self.gain
        self.agc_band = max(self.agc_band * 0.999, float(raw[:3].max()), 1e-3)
        self.agc_rms = max(self.agc_rms * 0.999, float(raw[3]), 1e-3)
        norm = np.empty(4, dtype=np.float32)
        norm[:3] = np.clip(raw[:3] / self.agc_band, 0, 1)
        norm[3] = min(1.0, raw[3] / self.agc_rms)
        atk, dec = 0.6, 0.12
        for i in range(4):
            a = atk if norm[i] > self.env[i] else dec
            self.env[i] += a * (norm[i] - self.env[i])
        flux = max(0.0, float(self.env[0]) - self.prev_bass)
        self.prev_bass = float(self.env[0])
        return self.env, flux

def _hue_lerp(a, b, t):
    """Blend hue a->b the short way around the wheel; t in 0..1 (no dip to dark)."""
    d = ((b - a + 0.5) % 1.0) - 0.5
    return (a + d * t) % 1.0

def update_color(state, now, flux, cfg):
    """Evolving base hue with smooth CROSS-FADES (the displayed hue eases toward a
    target rather than jumping): a silent timed color change fades over
    `silent_fade` seconds; a beat change fades faster over `beat_fade`. Brightness
    is the mode's job, so only the hue crossfades here -> no color/dark/color blink.
    Returns (hue, flash).

    palette=="shared": hue is a pure function of the wall clock, so every
    clock-synced cell matches; the silent crossfade is computed deterministically
    in the run-up to each cycle boundary, and beats pop brightness only (hue stays
    matched). palette=="free" (default): each cell eases its own hue toward a
    target that steps on the cycle and kicks on beats."""
    sf = max(0.05, cfg.get("silent_fade", 3.0))
    bf = max(0.02, cfg.get("beat_fade", 0.35))
    if cfg.get("palette") == "shared":
        cyc = cfg["cycle"]
        epoch = int(now / cyc)
        base_e = (cfg["drift"] * now + epoch * 0.381966) % 1.0
        remain = cyc - (now % cyc)
        if remain < sf:                                       # crossfade into next color
            nxt = (cfg["drift"] * now + (epoch + 1) * 0.381966) % 1.0
            bh = _hue_lerp(base_e, nxt, 1.0 - remain / sf)
        else:
            bh = base_e
        flash = state.get("flash", 0.0) * cfg["flash_decay"]
        if flux > cfg["beat_sens"] and now - state.get("last_beat", 0.0) > cfg["refractory"]:
            state["last_beat"] = now; flash = 1.0             # brightness pop only (keeps colors matched)
        state["flash"] = flash
        return bh, flash
    dt = now - state.get("last_t", now)
    state["last_t"] = now
    cur = state.get("cur_hue")
    if cur is None:
        cur = random.random(); state["target_hue"] = cur; state["fade_dur"] = sf
    tgt = (state.get("target_hue", cur) + cfg["drift"] * dt) % 1.0   # target always gently drifts
    if now >= state.get("next_step", 0.0):                   # timed (silent) color change
        if state.get("next_step", 0.0) > 0.0:
            tgt = (tgt + 0.381966) % 1.0                      # golden-angle hop
            state["fade_dur"] = sf                            # slow, gentle fade
        state["next_step"] = now + cfg["cycle"] * (0.75 + 0.5 * random.random())
    flash = state.get("flash", 0.0) * cfg["flash_decay"]
    if flux > cfg["beat_sens"] and now - state.get("last_beat", 0.0) > cfg["refractory"]:
        tgt = (tgt + cfg["beat_hue"]) % 1.0                   # color kick on the boom
        state["fade_dur"] = bf                                # faster fade on the beat
        state["last_beat"] = now; flash = 1.0
    cur = _hue_lerp(cur, tgt, min(1.0, dt / state.get("fade_dur", sf)))  # ease hue toward target
    state["cur_hue"] = cur; state["target_hue"] = tgt; state["flash"] = flash
    return cur, flash

def render(mode, env, flux, state, now, cfg):
    bass, mid, tre, overall = [float(v) for v in env]
    if mode == "vu":
        return (0, 0, 0, overall)
    if mode == "spectrum":
        return (bass, mid, tre, 0)
    if mode == "rainbow":
        state["hue"] = (state.get("hue", 0.0) + 0.0015 + overall * 0.01) % 1.0
        r, g, b = hsv_to_rgb(state["hue"], 1.0, max(0.05, overall))
        return (r, g, b, 0)
    if mode == "beat":
        if flux > cfg["beat_sens"]:
            state["hue"] = (state.get("hue", 0.0) + 0.14) % 1.0
            state["flash"] = 1.0
        state["flash"] = state.get("flash", 0.0) * 0.82
        r, g, b = hsv_to_rgb(state.get("hue", 0.0), 1.0, state["flash"])
        return (r, g, b, 0)
    if mode == "bloom":
        return render_bloom(env, flux, state, now, cfg)
    if mode == "shimmer":
        return render_shimmer(env, flux, state, now, cfg)
    # --- evolving-color modes ---
    hue, flash = update_color(state, now, flux, cfg)
    if mode == "pulse":
        v = max(cfg["floor"], min(1.0, overall * 0.9 + flash * 0.25))
        return hsv_to_rgb(hue, 1.0, v) + (0,)
    if mode == "party":
        v = max(cfg["floor"], min(1.0, overall))
        r, g, b = hsv_to_rgb(hue, 1.0, v)
        return (min(1.0, r + flash * 0.2), min(1.0, g + flash * 0.2),
                min(1.0, b + flash * 0.2), flash * 0.6)        # white pop on the boom
    if mode == "flow":
        fl = cfg["floor"]
        v = max(fl, min(1.0, fl + (1.0 - fl) * (bass * 1.0 + flash * 0.2)))
        r, g, b = hsv_to_rgb(hue, 1.0, v)
        # treble shimmer: a nearby hue at low saturation (NOT the complement, which
        # would sum with the base toward white under a full-spectrum signal)
        sh = min(0.35, tre * 0.45)
        sr, sg, sb = hsv_to_rgb((hue + 0.08) % 1.0, 0.8, sh)
        return (min(1.0, r + sr), min(1.0, g + sg), min(1.0, b + sb), 0)
    if mode == "groove":
        return render_groove(env, flux, state, now, cfg, hue, flash)
    return (0, 0, 0, 0)

def render_groove(env, flux, state, now, cfg, hue, flash):
    """flow's evolving colour, driven by three layers instead of one:
         slow  — 1.5 s energy average: the room's mood (verse vs chorus), with a slow AGC so quiet
                 passages really are dimmer instead of being normalised up;
         fast  — 80 ms energy with contrast expansion: the transients;
         tempo — onsets (bass flux) are timed; when 4+ regular gaps agree (0.3–1.2 s) a phase-locked
                 breath rides the beat even between hits, and the hue kick waits for the downbeat.
       Treble pulls the tint toward a cooler, whiter hue; bass deepens saturation."""
    bass, mid, tre, overall = [float(v) for v in env]
    dt = max(1e-3, min(0.1, now - state.get("g_t", now - 0.016))); state["g_t"] = now
    def ema(key, x, tau):
        a = 1.0 - math.exp(-dt / tau); state[key] = state.get(key, x) + a * (x - state.get(key, x)); return state[key]
    slow = ema("g_slow", overall, 1.5)
    fast = ema("g_fast", overall, 0.08)
    peak = state["g_peak"] = max(state.get("g_peak", 0.0) * (1.0 - dt / 12.0), slow, 0.05)   # 12 s AGC on the mood layer
    mood = min(1.0, slow / peak)                                   # 0..1, quiet passages stay down
    trans = max(0.0, min(1.0, (fast - 0.55 * slow) / 0.45)) ** 1.6  # contrast-expanded transient layer
    # --- tempo ---
    ons = state.setdefault("g_onsets", [])
    if flux > cfg["beat_sens"] and (not ons or now - ons[-1] > 0.22):
        ons.append(now); del ons[:-10]
    period = None
    if len(ons) >= 5:
        gaps = [b - a for a, b in zip(ons[-6:], ons[-5:]) if 0.28 <= b - a <= 1.25]
        if len(gaps) >= 4:
            gaps.sort(); med = gaps[len(gaps) // 2]
            if all(abs(g - med) < 0.12 * med for g in gaps): period = med
    breath = 0.0
    if period and ons and now - ons[-1] < 2.5 * period:
        ph = ((now - ons[-1]) / period) % 1.0
        breath = 0.5 + 0.5 * math.cos(2 * math.pi * ph)        # peaks on the predicted beat
    state["g_period"] = period
    fl = cfg["floor"]
    lvl = 0.30 * mood + 0.45 * trans + 0.25 * flash + 0.22 * breath * mood
    v = max(fl, min(1.0, fl + (1.0 - fl) * lvl))
    sat = max(0.55, min(1.0, 1.0 - 0.45 * tre + 0.25 * bass))     # treble cools and whitens, bass deepens
    h = (hue + 0.06 * tre - 0.03 * bass) % 1.0
    r, g, b = hsv_to_rgb(h, sat, v)
    w = min(0.6, flash * 0.35 * (0.5 + tre))                      # white only on the hits
    return (r, g, b, w)

# ---------- bloom / shimmer: one feature drives the light, another drives the colour ----------
#
# Shared pieces. Treble gets its own level tracking: the band envelope shares one AGC across bass/mid/treble, so on
# most music treble sits far below a kick and barely moves anything that uses it raw.

def _dt(state, key, now):
    dt = max(1e-3, min(0.1, now - state.get(key, now - 0.016))); state[key] = now
    return dt

def _ema(state, key, x, tau, dt):
    a = 1.0 - math.exp(-dt / tau); v = state.get(key, x) + a * (x - state.get(key, x)); state[key] = v
    return v

def _env(state, key, x, attack, release, dt):
    """Peak follower: fast up, slow down."""
    cur = state.get(key, x)
    tau = attack if x > cur else release
    cur += (1.0 - math.exp(-dt / tau)) * (x - cur); state[key] = cur
    return cur

def _treble(state, tre, dt):
    """Treble on its own scale: (fast 0..1, slow 0..1, transient 0..1)."""
    pk = state["t_peak"] = max(state.get("t_peak", 0.0) * (1.0 - dt / 8.0), tre, 0.02)   # 8 s AGC
    t = min(1.0, tre / pk)
    fast = _env(state, "t_fast", t, 0.025, 0.12, dt)
    slow = _ema(state, "t_slow", t, 1.2, dt)
    trans = max(0.0, min(1.0, (fast - 0.55 * slow) / 0.45)) ** 1.4
    return fast, slow, trans

def _beats(state, flux, now, cfg, dt):
    """Onsets from the bass flux, the tempo they imply, and whether this one is an accent.
    Returns (hit, strength 0..1, accent, period or None, phase 0..1 or None)."""
    ons = state.setdefault("k_ons", [])
    if "_onset" in state:                                  # viz feed: the spectral onset detector (VizBands)
        o = state["_onset"]
        avg = _ema(state, "k_avg", o, 3.0, dt)
        hit = o > 0.0 and (not ons or now - ons[-1] > 0.2)
        strength = o
        accent_now = o > 0.9
    else:                                                  # the JACK path: the envelope's flux, as the other modes
        avg = _ema(state, "k_avg", flux, 2.0, dt)
        hit = flux > cfg["beat_sens"] and (not ons or now - ons[-1] > 0.22)
        strength = max(0.0, min(1.0, flux / max(avg * 3.0, cfg["beat_sens"] * 1.5)))
        accent_now = flux > max(avg * 4.0, cfg["beat_sens"] * 2.5)
    accent = False
    if hit:
        ons.append(now); del ons[:-12]
        n = state["k_n"] = state.get("k_n", 0) + 1
        accent = accent_now or (state.get("k_period") is not None and n % 4 == 1)
    else:
        strength = 0.0
    period = None
    if len(ons) >= 5:
        gaps = [b - a for a, b in zip(ons[-6:], ons[-5:]) if 0.28 <= b - a <= 1.25]
        if len(gaps) >= 4:
            gaps.sort(); med = gaps[len(gaps) // 2]
            if all(abs(g - med) < 0.12 * med for g in gaps): period = med
    if period is None and state.get("k_period") is not None:
        state["k_n"] = 0                                   # tempo lost: count the bar again from the next lock
    state["k_period"] = period
    phase = (((now - ons[-1]) / period) % 1.0) if (period and ons and now - ons[-1] < 2.5 * period) else None
    return hit, strength, accent, period, phase

def _mood(state, overall, dt):
    slow = _ema(state, "m_slow", overall, 1.5, dt)
    peak = state["m_peak"] = max(state.get("m_peak", 0.0) * (1.0 - dt / 12.0), slow, 0.05)
    return min(1.0, slow / peak)

def render_bloom(env, flux, state, now, cfg):
    """BLOOM — brightness on the beat, colour from the treble.
    Each kick blooms the light and lets it fall away; with a tempo locked the fall-away is timed to it (a long breath
    on slow songs, tight pulses on fast ones), and a soft swell rises into the next predicted beat so the gaps keep
    moving. The resting level follows the passage (12 s AGC). The colour sits on a range around the slowly evolving
    base hue: warm and deep when the top end is quiet, cooler and paler as hats and cymbals come in."""
    bass, mid, tre, overall = [float(v) for v in env]
    dt = _dt(state, "bl_t", now)
    base_hue, _ = update_color(state, now, 0.0, cfg)          # the palette drifts; beats don't push the colour here
    hit, strength, accent, period, phase = _beats(state, flux, now, cfg, dt)
    mood = _mood(state, overall, dt)
    tf, ts, tt = _treble(state, tre, dt)
    lvl = state.get("bl_lvl", 0.0)
    if hit:
        lvl = max(lvl, 0.55 + 0.45 * strength + (0.1 if accent else 0.0))
    tau = (0.42 * period) if period else 0.26
    lvl *= math.exp(-dt / tau)
    state["bl_lvl"] = lvl
    swell = (0.5 - 0.5 * math.cos(2 * math.pi * phase)) ** 3 * 0.18 if phase is not None else 0.0   # rises into the beat
    fl = cfg["floor"]
    rest = fl + 0.20 * mood
    v = max(fl, min(1.0, rest + (1.0 - rest) * min(1.0, lvl + swell * mood)))
    tcol = _ema(state, "bl_tc", 0.65 * ts + 0.35 * tf, 0.18, dt)   # glide, don't flicker
    h = (base_hue - 0.07 + 0.16 * tcol) % 1.0                     # warm end -> cool end of the base hue's range
    sat = max(0.62, min(1.0, 1.0 - 0.28 * tcol))
    r, g, b = hsv_to_rgb(h, sat, v)
    w = min(0.45, 0.35 * tt * tt * lvl)                           # a white glint when a bright beat meets a hat
    return (r, g, b, w)

def render_shimmer(env, flux, state, now, cfg):
    """SHIMMER — brightness from the treble, colour on the beat.
    The light rides the treble on its own scale: it sparkles on hats, rides cymbal washes, and calms down when the
    top end does. The colour holds, then steps on each beat with a crossfade timed to the tempo; an accent (the
    bar's downbeat once the tempo is locked, or a much harder hit) takes a bigger step, so a bar reads small, small,
    small, big. Bass adds a little body under the sparkle so quiet-top songs don't go dark."""
    bass, mid, tre, overall = [float(v) for v in env]
    dt = _dt(state, "sh_t", now)
    hit, strength, accent, period, phase = _beats(state, flux, now, cfg, dt)
    mood = _mood(state, overall, dt)
    tf, ts, tt = _treble(state, tre, dt)
    if "sh_hue" not in state:
        state["sh_hue"] = random.random(); state["sh_tgt"] = state["sh_hue"]
    tgt = (state["sh_tgt"] + cfg["drift"] * dt) % 1.0
    if hit:
        tgt = (tgt + (0.17 if accent else 0.035 + 0.025 * strength)) % 1.0   # small steps; an accent moves on
        state["sh_fade"] = max(0.08, (0.35 * period) if period else 0.16)
    if now >= state.get("sh_next", 0.0):                          # no beats for a while: the silent palette step
        if state.get("sh_next", 0.0) > 0.0 and now - state.get("k_ons", [0.0])[-1:][0] > cfg["cycle"] * 0.5:
            tgt = (tgt + 0.381966) % 1.0; state["sh_fade"] = max(0.05, cfg.get("silent_fade", 3.0))
        state["sh_next"] = now + cfg["cycle"]
    hue = _hue_lerp(state["sh_hue"], tgt, min(1.0, dt / state.get("sh_fade", 0.16)))
    state["sh_hue"] = hue; state["sh_tgt"] = tgt
    hat = state.get("_hat", 0.0)
    spark = state.get("sh_spark", 0.0) * math.exp(-dt / 0.09)     # each hi-hat / cymbal hit: a spark, ~90 ms
    if hat > 0.0: spark = max(spark, 0.45 + 0.55 * hat)
    state["sh_spark"] = spark
    if "_hat" not in state: spark = max(spark, tt)                # JACK path: no onsets, use the transient level
    body = _env(state, "sh_body", bass, 0.05, 0.4, dt) * 0.14 * mood
    fl = cfg["floor"]
    lvl = 0.20 * ts * ts + 0.20 * tt + 0.55 * spark + body        # quiet glow from the top end, sparks on the hits
    v = max(fl, min(1.0, fl + (1.0 - fl) * lvl))
    sat = max(0.62, min(1.0, 1.0 - 0.32 * spark))
    r, g, b = hsv_to_rgb(hue, sat, v)
    w = min(0.45, 0.42 * spark ** 3)                              # only the hardest sparks go white
    return (r, g, b, w)

def discover_ports(kind):
    try:
        out = subprocess.check_output(["jack_lsp"], stderr=subprocess.DEVNULL).decode()
    except Exception:
        return []
    key = "playback" if kind == "playback" else "capture"
    return [p for p in out.split() if key in p]

# ---------- viz feed: VisualizationDataBroadcast (msgpack over UDP) ----------
_INTS = {}
def _ints16(b, i, n):
    """n msgpack int16s (0xd1 hi lo each) from i in one struct call — the viz feed's arrays are all this
    shape; anything else returns None and takes the general path."""
    end = i + 3 * n
    if n and b[i:end:3] == b"\xd1" * n:
        f = _INTS.get(n)
        if f is None: f = _INTS[n] = struct.Struct(">" + "xh" * n).unpack_from
        return list(f(b, i)), end
    return None, i

def _mp(b, i=0):
    """Minimal MessagePack decoder for the subset the Syng viz feed uses."""
    c = b[i]
    if c == 0xdc:
        v, j = _ints16(b, i + 3, (b[i + 1] << 8) | b[i + 2])
        if v is not None: return v, j
    elif 0x91 <= c <= 0x9f:
        v, j = _ints16(b, i + 1, c & 0x0f)
        if v is not None: return v, j
    i += 1
    if c < 0x80: return c, i
    if c >= 0xe0: return c - 256, i
    if 0x80 <= c <= 0x8f:
        d = {}
        for _ in range(c & 0x0f):
            k, i = _mp(b, i); v, i = _mp(b, i); d[k] = v
        return d, i
    if 0x90 <= c <= 0x9f:
        a = []
        for _ in range(c & 0x0f):
            v, i = _mp(b, i); a.append(v)
        return a, i
    if 0xa0 <= c <= 0xbf:
        n = c & 0x1f; return b[i:i+n].decode("utf-8", "replace"), i + n
    if c == 0xc0: return None, i
    if c == 0xc2: return False, i
    if c == 0xc3: return True, i
    if c == 0xca: return struct.unpack_from(">f", b, i)[0], i + 4
    if c == 0xcb: return struct.unpack_from(">d", b, i)[0], i + 8
    if c == 0xcc: return b[i], i + 1
    if c == 0xcd: return struct.unpack_from(">H", b, i)[0], i + 2
    if c == 0xce: return struct.unpack_from(">I", b, i)[0], i + 4
    if c == 0xd0: return struct.unpack_from(">b", b, i)[0], i + 1
    if c == 0xd1: return struct.unpack_from(">h", b, i)[0], i + 2
    if c == 0xd2: return struct.unpack_from(">i", b, i)[0], i + 4
    if c == 0xd9:
        n = b[i]; i += 1; return b[i:i+n].decode("utf-8", "replace"), i + n
    if c == 0xda:
        n = struct.unpack_from(">H", b, i)[0]; i += 2
        return b[i:i+n].decode("utf-8", "replace"), i + n
    if c == 0xdc:
        n = struct.unpack_from(">H", b, i)[0]; i += 2; a = []
        for _ in range(n):
            v, i = _mp(b, i); a.append(v)
        return a, i
    if c == 0xdd:
        n = struct.unpack_from(">I", b, i)[0]; i += 4; a = []
        for _ in range(n):
            v, i = _mp(b, i); a.append(v)
        return a, i
    if c == 0xde:
        n = struct.unpack_from(">H", b, i)[0]; i += 2; d = {}
        for _ in range(n):
            k, i = _mp(b, i); v, i = _mp(b, i); d[k] = v
        return d, i
    return None, i

class _Onset:
    """Peak-picking onset detector on a flux signal (one value per feed packet, ~30/s): fires when the flux tops a
    running mean + k running deviations (and 3 dB), only on the packet where it peaks, at most every 0.12 s.
    Returns 0, or the onset's strength 0..1 (how far over the threshold it went)."""
    def __init__(self):
        self.mean = 0.0; self.dev = 1.0; self.prev = 0.0; self.pending = 0.0; self.quiet = 0
    def feed(self, x, k):
        thr = self.mean + k * self.dev + 3.0
        out = 0.0
        if self.pending > 0.0 and x < self.prev:          # the previous packet was the peak
            out = self.pending; self.pending = 0.0; self.quiet = 3
        elif x > thr and self.quiet <= 0:
            self.pending = max(self.pending, min(1.0, 0.25 + (x - thr) / (2.0 * self.dev + 6.0)))
        self.quiet -= 1
        a = 0.06                                          # ~0.5 s memory at 30 packets/s
        self.dev += a * (abs(x - self.mean) - self.dev)
        self.mean += a * (x - self.mean)
        self.prev = x
        return out

class VizBands:
    """Map the VisualizationDataBroadcast spectrum (88 bins, centi-dB) to the same
    (env[bass,mid,tre,overall], flux) that Bands produces, so render() is reused."""
    K = math.log(10.0) / 2000.0          # centi-dB -> linear amplitude: 10 ** (x / 100 / 20)

    def __init__(self, gain, beat_sens=0.08):
        self.gain = gain
        self.env = [0.0, 0.0, 0.0, 0.0]
        self.agc_band = 1e-3; self.agc_rms = 1e-3; self.prev_bass = 0.0
        # onsets from the raw spectrum (bloom / shimmer): per-bin dB rise summed over a band, against an adaptive
        # threshold. The smoothed envelope's own "flux" sees a kick as a small nudge and misses most of them.
        self.prev_db = None
        self.k = 1.0 + 12.0 * beat_sens          # threshold in deviations: beat_sens 0.05 -> 1.6, 0.08 -> 2.0
        self.kick = _Onset(); self.hat = _Onset()
        self.onset = 0.0; self.hat_onset = 0.0

    def feed(self, spec, rms):
        n = len(spec)
        if n < 6:
            return self.env, 0.0
        db = [x * 0.01 for x in spec]
        if self.prev_db is not None and len(self.prev_db) == n:
            pv = self.prev_db
            lo_b = max(2, int(n * 0.12)); hi_b = int(n * 0.55)
            sb = 0.0
            for i in range(1, lo_b):
                d = db[i] - pv[i]
                if d > 0: sb += d
            st = 0.0
            for i in range(hi_b, n):
                d = db[i] - pv[i]
                if d > 0: st += d
            self.onset = self.kick.feed(sb, self.k)
            self.hat_onset = self.hat.feed(st * (lo_b - 1) / max(1, n - hi_b), self.k)
        else:
            self.onset = self.hat_onset = 0.0
        self.prev_db = db
        k = self.K; ex = math.exp
        m = [ex(x * k) for x in spec]
        lo = max(2, int(n * 0.12)); mi = int(n * 0.45)
        bass = sum(m[1:lo]) / (lo - 1); mid = sum(m[lo:mi]) / (mi - lo); tre = sum(m[mi:]) / (n - mi)
        overall = ex(max(rms) * k) if rms else sum(m) / n
        g = self.gain
        raw = (bass * g, mid * g, tre * g, overall)
        self.agc_band = max(self.agc_band * 0.999, raw[0], raw[1], raw[2], 1e-3)
        self.agc_rms = max(self.agc_rms * 0.999, raw[3], 1e-3)
        ab = self.agc_band
        norm = (min(1.0, max(0.0, raw[0] / ab)), min(1.0, max(0.0, raw[1] / ab)),
                min(1.0, max(0.0, raw[2] / ab)), min(1.0, raw[3] / self.agc_rms))
        env = self.env
        for i in range(4):
            a = 0.6 if norm[i] > env[i] else 0.12
            env[i] += a * (norm[i] - env[i])
        flux = max(0.0, env[0] - self.prev_bass)
        self.prev_bass = env[0]
        return env, flux

def run_viz(args, cfg):
    """LED from the Syng viz feed (UDP msgpack). The agent fans the feed to this
    cell; we just listen, map to env, and render. No JACK, no mic."""
    if not args.no_manage:
        subprocess.call(["systemctl", "stop", "ledmanager"])
    pwm = Pwm(args.period)
    def cleanup(*_):
        try: pwm.off()
        except Exception: pass
        if not args.no_manage:
            subprocess.call(["systemctl", "start", "ledmanager"])
        os._exit(0)
    signal.signal(signal.SIGINT, cleanup)
    signal.signal(signal.SIGTERM, cleanup)
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.bind(("0.0.0.0", args.viz_port))
    sock.setblocking(False)
    bands = VizBands(args.gain, cfg.get("beat_sens", 0.08))
    state = {}; flux_acc = 0.0; last_pkt = 0.0; last_dbg = 0.0; onset_acc = 0.0; hat_acc = 0.0
    sys.stderr.write("reactive(viz): mode=%s udp=%d — waiting for feed\n" % (args.mode, args.viz_port))
    tick = 1.0 / 60.0
    while True:
        got = False
        while True:
            try:
                data, _ = sock.recvfrom(65535)
            except (BlockingIOError, OSError):
                break
            try:
                obj, _ = _mp(data, 0)
                if isinstance(obj, dict) and obj.get("stems"):
                    spec = obj["stems"][0] if obj.get("stems") else []
                    _, f = bands.feed(spec, obj.get("stemsRms") or [])
                    flux_acc = max(flux_acc, f); got = True
                    onset_acc = max(onset_acc, bands.onset); hat_acc = max(hat_acc, bands.hat_onset)
            except Exception:
                pass
        now = time.time()
        if got:
            last_pkt = now
        elif now - last_pkt > 0.25:
            bands.env = [x * 0.90 for x in bands.env]   # feed stalled -> fade gently
        state["_onset"] = onset_acc; state["_hat"] = hat_acc      # read by bloom / shimmer (viz feed only)
        pwm.set_rgbw(*render(args.mode, bands.env, flux_acc, state, now, cfg))
        flux_acc *= 0.5; onset_acc = 0.0; hat_acc = 0.0
        if args.debug and now - last_dbg > 0.3:
            last_dbg = now
            sys.stderr.write("viz bass=%.2f mid=%.2f tre=%.2f ov=%.2f age=%.2fs\r"
                             % (bands.env[0], bands.env[1], bands.env[2], bands.env[3], now - last_pkt))
            sys.stderr.flush()
        time.sleep(tick)

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--mode", default="pulse",
                    choices=["vu", "spectrum", "beat", "rainbow", "pulse", "party", "flow", "groove", "bloom", "shimmer"])
    ap.add_argument("--source", default="playback", choices=["playback", "mic", "viz"])
    ap.add_argument("--viz-port", type=int, default=7249, help="UDP port for the viz feed (--source viz)")
    ap.add_argument("--ports", default="")
    ap.add_argument("--fps", type=int, default=60)
    ap.add_argument("--gain", type=float, default=1.0)
    ap.add_argument("--rate", type=int, default=48000)
    ap.add_argument("--period", type=int, default=22767)
    # evolving-color controls (pulse/party/flow)
    ap.add_argument("--cycle", type=float, default=20.0, help="seconds between palette steps")
    ap.add_argument("--beat-sens", type=float, default=0.08, help="bass-boom threshold (lower=touchier)")
    ap.add_argument("--beat-hue", type=float, default=0.12, help="hue jump per boom (0-1)")
    ap.add_argument("--floor", type=float, default=0.06, help="minimum brightness so it never goes dark")
    ap.add_argument("--palette", default="free", choices=["free", "shared"],
                    help="free=each cell its own color (default); shared=whole group matches one evolving color")
    ap.add_argument("--silent-fade", type=float, default=3.0,
                    help="flow/pulse/party: seconds to crossfade to the next color when idle")
    ap.add_argument("--beat-fade", type=float, default=0.35,
                    help="flow/pulse/party: seconds to crossfade to the next color on a beat")
    ap.add_argument("--debug", action="store_true")
    ap.add_argument("--no-manage", action="store_true")
    args = ap.parse_args()
    cfg = {"cycle": args.cycle, "beat_sens": args.beat_sens, "beat_hue": args.beat_hue,
           "floor": args.floor, "palette": args.palette,
           "silent_fade": args.silent_fade, "beat_fade": args.beat_fade,
           "drift": 0.01, "refractory": 0.15, "flash_decay": 0.85}

    if args.source == "viz":
        return run_viz(args, cfg)

    ports = [p for p in args.ports.split(",") if p] or discover_ports(args.source)
    if not ports:
        sys.exit("No JACK %s ports found. Run `jack_lsp` on the Cell and pass --ports a,b"
                 % args.source)
    nch = len(ports)

    cmd = ["jack_capture", "--write-to-stdout", "--no-stdin", "--disable-meter",
           "--channels", str(nch)]
    for p in ports:
        cmd += ["--port", p]
    sys.stderr.write("ports (%d): %s\n" % (nch, ", ".join(ports)))
    sys.stderr.write("capture: %s\n" % " ".join(cmd))

    if not args.no_manage:
        subprocess.call(["systemctl", "stop", "ledmanager"])

    cap = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, bufsize=0)
    errbuf = []
    def drain_err():
        for line in iter(cap.stderr.readline, b""):
            errbuf.append(line.decode("utf-8", "replace").rstrip())
    threading.Thread(target=drain_err, daemon=True).start()

    pwm = [None]
    def cleanup(*_):
        try: cap.terminate()
        except Exception: pass
        if pwm[0]: pwm[0].off()
        if not args.no_manage:
            subprocess.call(["systemctl", "start", "ledmanager"])
        os._exit(0)
    signal.signal(signal.SIGINT, cleanup)
    signal.signal(signal.SIGTERM, cleanup)

    fd = cap.stdout.fileno()
    frames = max(1, args.rate // args.fps)
    chunk = frames * nch * 2
    # watchdog: data must arrive within 5s or we bail with jack_capture's stderr
    r, _, _ = select.select([fd], [], [], 5.0)
    if not r:
        sys.stderr.write("No audio from jack_capture within 5s. Its output:\n  %s\n"
                         % "\n  ".join(errbuf[-15:] or ["(none)"]))
        cleanup()

    pwm[0] = Pwm(args.period)
    bands = Bands(args.rate, 1024, args.gain)
    state = {}
    buf = b""
    last_dbg = 0.0
    sys.stderr.write("reactive: mode=%s rate=%d ch=%d — running\n"
                     % (args.mode, args.rate, nch))
    while True:
        rr, _, _ = select.select([fd], [], [], 2.0)
        if not rr:
            if cap.poll() is not None:
                sys.stderr.write("jack_capture exited:\n  %s\n" % "\n  ".join(errbuf[-15:]))
                break
            continue
        data = os.read(fd, 65536)
        if not data:
            break
        buf += data
        while len(buf) >= chunk:
            block = buf[:chunk]; buf = buf[chunk:]
            a = np.frombuffer(block, dtype="<i2").astype(np.float32)
            if nch > 1:
                a = a.reshape(-1, nch).mean(axis=1)
            a /= 32768.0
            env, flux = bands.feed(a)
            pwm[0].set_rgbw(*render(args.mode, env, flux, state, time.time(), cfg))
            if args.debug and time.time() - last_dbg > 0.2:
                last_dbg = time.time()
                sys.stderr.write("bass=%.2f mid=%.2f tre=%.2f rms=%.2f flux=%.2f\r"
                                 % (env[0], env[1], env[2], env[3], flux))
                sys.stderr.flush()
    cleanup()

if __name__ == "__main__":
    main()
