[Unit]
Description=Syng Cell sound-reactive LED
# Needs the JACK audio graph; takes over the LED from ledmanager while active.
After=jackd.service ledmanager.service syngsoundserver.service
Wants=jackd.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/syng-led-reactive
# The daemon stops ledmanager on start and restarts it on exit (SIGTERM),
# so `systemctl stop` restores the normal LED behaviour automatically.
ExecStart=/usr/bin/syng-led-reactive $ARGS
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
